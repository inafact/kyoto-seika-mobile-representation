/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), fullscreen=(self), screen-wake-lock=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), publickey-credentials-create=(self), publickey-credentials-get=(self)

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
